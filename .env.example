# ============================================================
# CLIENT ENVIRONMENT VARIABLES (VITE_)
# ============================================================
# EmailJS Configuration for Contact Form
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# ============================================================
# SERVER-ONLY ENVIRONMENT VARIABLES (NO VITE_ PREFIX)
# Configure these in Vercel Project Settings -> Environment Variables
# ============================================================

# Admin Password for /admin/careers portal
CAREERS_ADMIN_PASSWORD=your_secure_admin_password_here

# Required: Independent random secret for signing one-hour admin sessions
CAREERS_SESSION_SECRET=your_random_32_character_secret_here

# HR Email address for candidate applications (used in mailto link and admin portal)
CAREERS_HR_EMAIL=hr@milestoneconsultancy.in

# Required: Private Vercel Blob Read/Write Token for careers reads and writes
# Automatically populated by Vercel when connecting Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# Optional: comma-separated exact HTTPS preview origins; no wildcard domains
CAREERS_TRUSTED_ORIGINS=
